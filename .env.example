# Exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas informações

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=5541998821250

# Facebook Pixel & Conversions API (CAPI)
# ID do seu Pixel do Facebook (público)
NEXT_PUBLIC_META_PIXEL_ID=4497279150508477

# Access Token para a Conversions API (PRIVADO - não compartilhar!)
# Para gerar: https://business.facebook.com/events_manager2/list/pixel/YOUR_PIXEL_ID/settings/conversions_api
# Passos:
# 1. Acesse o Gerenciador de Eventos do Facebook
# 2. Selecione seu Pixel (4497279150508477)
# 3. Vá em Configurações > API de Conversões
# 4. Clique em "Gerar token de acesso"
# 5. Copie o token gerado e cole abaixo
META_CAPI_ACCESS_TOKEN=

# (Opcional) Código de evento de teste para validar eventos no Gerenciador de Eventos
# Para testar: https://business.facebook.com/events_manager2/list/pixel/YOUR_PIXEL_ID/test_events
META_TEST_EVENT_CODE=

# Email (se usar serviço de email)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Informações de contato
NEXT_PUBLIC_CONTACT_EMAIL=gabriellecristinecarraro@gmail.com
